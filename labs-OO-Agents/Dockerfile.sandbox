FROM python:3.12-slim

# Install minimal dependencies needed for the sandbox worker
RUN pip install --no-cache-dir pydantic pyyaml litellm

WORKDIR /app

# Copy the core library
COPY src/ /app/src/

# Start the worker module when the container runs
CMD ["python", "-m", "nooa.runtime.sandbox.worker"]

# Ensure the library is importable
ENV PYTHONPATH=/app/src

# Start the worker reading from standard input
ENTRYPOINT ["python", "-m", "nooa.runtime.sandbox.worker"]
